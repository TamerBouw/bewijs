# Voorbeeld van de geheimen en instellingen van de balie-agent (FICTIEF).
# Kopieer naar supabase/functions/.env voor lokaal testen en vul de waarden in.
# In productie: npx supabase secrets set --env-file supabase/functions/.env
# Namen die met SUPABASE_ beginnen zijn gereserveerd: SUPABASE_URL en SUPABASE_SECRET_KEYS krijgt elke Edge Function vanzelf.

# Sleutel uit de Anthropic-workspace bubbel-productie (alleen geldig in die workspace)
ANTHROPIC_API_KEY=
# Model-id; wissel alleen na een groene evalrun (zie RUNBOOK.md)
AGENT_MODEL=claude-haiku-5-5
# Klant-slug voor logs en alerts
KLANT_SLUG=bubbel
# Maximaal modelgebruik per dag in euro; daarboven zet de agent alles door naar een mens
API_DAGBUDGET_EUR=2.00
# Maandlimiet in euro voor de kostenalert (80% van deze waarde geeft een alert)
MAANDLIMIET_EUR=25
# Eigen token dat de berichtenapp meestuurt in de header x-balie-token (geen Supabase-sleutel)
BALIE_WEBHOOK_TOKEN=
# Sleutel van Resend voor alertmails
RESEND_API_KEY=
# Wie de alerts krijgt
ALERT_MAIL_AAN=beheer@bureauvonk.example
